<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="timesheetDAO"
          class="com._4s_.timesheet.dao.TimesheetDAOHibernate">
        <property name="sessionFactory" ref="sessionFactory"/>
        <property name="externalQueries" ref="timesheetExternalQueries"/>
    </bean>

    <bean id="timesheetExternalQueries"
          class="com._4s_.timesheet.dao.TimesheetExternalQueries">
        <property name="sessionFactory" ref="sessionFactory"/>
        <property name="platformTransactionManager"
                  ref="transactionManager"/>
        <property name="dataSource" ref="dataSource"/>
    </bean>

</beans>